generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  clerkUserId String   @unique
  email       String   @unique
  role        String   @default("user")
  createdAt   DateTime @default(now())
}


